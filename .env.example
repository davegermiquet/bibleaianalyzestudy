# llama.cpp OpenAI-compatible servers
# Chat (ask answers) — e.g. Qwen3-14B on :8080
LLAMA_BASE_URL=http://localhost:8080/v1/
# Embeddings (ingest + retrieve) — e.g. Qwen3-Embedding-0.6B on :8081
LLAMA_EMBED_BASE_URL=http://localhost:8080/v1/
LLAMA_MODEL=local
LLAMA_EMBED_MODEL=local
LLAMA_API_KEY=not-needed
# Client timeout in seconds; 0 = wait forever for model output
LLAMA_TIMEOUT=0
# Max tokens to generate per answer (lower = finishes sooner)
LLAMA_MAX_TOKENS=2048

# Embedding dimension must match the embedding model loaded in llama.cpp
EMBED_DIM=1024

# --- Milvus connection (pick ONE mode) ---
#
# Remote Milvus on Kubernetes:
#   - Port-forward: http://127.0.0.1:19530
#   - In-cluster:  http://milvus.milvus.svc.cluster.local:19530
# Do NOT set the env var named MILVUS_URI (reserved by pymilvus).
MILVUS_URL=http://localhost:19530
MILVUS_TOKEN=local
# MILVUS_USER=root
# MILVUS_PASSWORD=Milvus
MILVUS_DB_NAME=default
#
# Local Milvus Lite fallback (used only when MILVUS_URL is unset):
MILVUS_DB_PATH=./milvus_bible.db

# One collection for all religions + translations (append each CSV)
COLLECTION_NAME=scriptures

# Bible CSV: embed reference + text
TEXT_COLS=Book,Chapter,Verse,Text
